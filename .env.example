# Both Sides — environment variables
#
# Every value here is optional for local development. With none of them set the
# app runs against an embedded PGlite database and a sealed offline corpus, so
# `git clone && npm install && npm run dev` works with no setup at all.
#
# Production requires DATABASE_URL. The app refuses to start in production
# without it, because a serverless filesystem is not durable.

# --- Production datastore (required in production) ------------------------------
# Hosted Postgres. The app creates its tables on first request; every statement
# is idempotent.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Transport for DATABASE_URL. Leave unset for Neon: a *.neon.tech host is sent
# through Neon's serverless HTTP driver, anything else through a normal TCP
# connection. Set explicitly to `tcp` or `http` to override the detection.
# DATABASE_DRIVER=tcp

# --- Sanity (Content Lake) ------------------------------------------------------
# The project id and dataset are public identifiers and are also compiled in as
# defaults in src/lib/site.ts. Set them here to point at a different dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=4npxmu4m
NEXT_PUBLIC_SANITY_DATASET=production

# Optional read token. Only needed if you make the dataset private. Public
# datasets need no token for published documents. Server-side only.
SANITY_API_READ_TOKEN=

# Optional write token with Editor permission. Needed only to seed the Content
# Lake from a script or to run `sanity schemas deploy`. Never expose it to the
# browser and never commit it.
SANITY_API_WRITE_TOKEN=

# --- Deployment -----------------------------------------------------------------
# Used for canonical URLs, OpenGraph tags and the sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://both-sides.vercel.app

# --- Local development only -----------------------------------------------------
# Where the embedded database writes. Relative to web/.
PGLITE_DIR=./.data/pglite